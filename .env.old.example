# Environment for the isolated "old" stack (docker-compose.old.yml).
# Copy to .env.old on the server and fill in real secrets. Do NOT commit .env.old.
#
#   cp .env.old.example .env.old   &&   nano .env.old

# Fresh, isolated MySQL for the old stack. Use a NEW password — not the live one.
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=alqavi_old

# Django secret for the old stack (generate a new random one, do not reuse live).
SECRET_KEY=change-me-random-50-chars

# Hosts Django will serve. Keep the subdomain; others help health checks.
DJANGO_ALLOWED_HOSTS=old.alqavitraders.com,oldnginx,localhost,127.0.0.1

# Baked into the Next.js bundle at build time. MUST match the public subdomain.
NEXT_PUBLIC_API_URL=https://old.alqavitraders.com/api
